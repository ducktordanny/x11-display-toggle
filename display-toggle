#!/usr/bin/env bash
set -euo pipefail

MAIN="DP-0"
MAIN_NAME="Dell"
MAIN_SIZE="2560x1440"
MAIN_HZ=165.08

SIDE="HDMI-0"
SIDE_NAME="Samsung"
SIDE_SIZE="1920x1080"
SIDE_HZ=74.97

is_joined() {
  xrandr --listmonitors | grep -q "$MAIN"
}

single() {
  echo "Single display: $SIDE_NAME $SIDE_SIZE@$SIDE_HZ"
  xrandr --output "$MAIN" --off \
         --output "$SIDE" --mode $SIDE_SIZE --rate $SIDE_HZ --left-of "$MAIN" --auto
}

join() {
  echo "Join displays: $MAIN_NAME $MAIN_SIZE@$MAIN_HZ + $SIDE_NAME $SIDE_SIZE@$SIDE_HZ"
  xrandr --output "$MAIN" --mode $MAIN_SIZE --rate $MAIN_HZ --primary --auto \
         --output "$SIDE" --mode $SIDE_SIZE --rate $SIDE_HZ --left-of "$MAIN" --auto
}

if is_joined; then
  single
else
  join
fi
